# Database Password for local Docker Compose PostGIS (default fallback: heimspiel_secret)
DB_PASSWORD="heimspiel_secret"

# PostgreSQL Connection URL (only required if running locally outside Docker without Compose)
# DATABASE_URL=postgresql://username:password@ep-cool-fog-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Raspberry Pi Deployment Target (optional, read by npm run docker:deploy-pi)
PI_HOST="pi@raspberrypi.local"
PI_DIR="~/heimspielradar"

# Telegram Bot Alerting & Notifications (Optional)
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# TELEGRAM_CHAT_ID="-1001234567890"

# Scraper Secret (Optional token for manual trigger endpoints)
# SCRAPER_SECRET="your-scraper-secret"

# Admin Dashboard & API Security
ENABLE_ADMIN_API=true
# ADMIN_API_SECRET="your-secure-admin-secret"
# VITE_ENABLE_ADMIN_UI=true

# Frontend Donation (Hallenkaffee) & Transparency Links (Optional)
# VITE_DONATION_URL="https://buymeacoffee.com/dimi.kokkonias"
# VITE_TRANSPARENCY_URL="https://github.com/TheCodeOne/HeimspielRadar/blob/main/TRANSPARENCY.md"
