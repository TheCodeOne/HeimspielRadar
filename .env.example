# PostgreSQL Connection URL (e.g. from free Neon.tech instance)
DATABASE_URL=postgresql://username:password@ep-cool-fog-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Port for NestJS backend (default: 3000)
PORT=3000

# Raspberry Pi Deployment Target (optional, read by npm run docker:deploy-pi)
PI_HOST="pi@raspberrypi.local"
PI_DIR="~/heimspielradar"

# Scraper Cron Scheduling (@nestjs/schedule)
ENABLE_CRON_SYNC=false
CRON_DELTA_SCHEDULE="0 5,18 * * *"
CRON_DEEP_SCHEDULE="0 2 * * 2"
